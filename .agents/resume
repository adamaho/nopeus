#!/usr/bin/env bash
set -euo pipefail

# Check the restored pinned tools without reinstalling dependencies on every wake.
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"
node_version="$(node --version)"
pnpm_version="$(pnpm --version)"
echo "Nopeus ready: Node $node_version, pnpm $pnpm_version"
