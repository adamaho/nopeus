#!/usr/bin/env bash
set -euo pipefail

# Oxlint reserves a 6 GiB virtual buffer without using that much physical RAM.
# Small orbs reject it with the default heuristic overcommit policy. Kernel
# settings may reset when a snapshot is restored, so repair this on each wake.
if [[ "$(cat /proc/sys/vm/overcommit_memory)" != 1 ]]; then
  sudo -n sysctl -w vm.overcommit_memory=1
fi

# No authentication or backing services are needed by the current packages.
# Check the restored tools without reinstalling dependencies on every wake.
export PATH="$HOME/.local/share/nopeus-toolchain/bin:$PATH"
node_version="$(node --version)"
pnpm_version="$(pnpm --version)"
echo "Nopeus ready: Node $node_version, pnpm $pnpm_version"
