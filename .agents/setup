#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SECONDS=0

readonly node_version="24.15.0"
readonly pnpm_version="12.3.4"
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

echo "Preparing Node $node_version and pnpm $pnpm_version"
if ! docker compose version >/dev/null 2>&1; then
  echo "Installing the Docker Compose plugin..."
  sudo apt-get update
  sudo apt-get install -y docker-compose-plugin
fi

installed_pnpm_version=""
if [[ -x "$PNPM_HOME/bin/pnpm" ]]; then
  installed_pnpm_version="$(
    cd "$HOME"
    "$PNPM_HOME/bin/pnpm" --version 2>/dev/null || true
  )"
fi

if [[ "$installed_pnpm_version" != "$pnpm_version" ]]; then
  curl --fail --location --retry 3 https://get.pnpm.io/install.sh |
    PNPM_VERSION="$pnpm_version" ENV="$HOME/.bashrc" SHELL=/bin/bash sh -
fi

if [[ ! -x "$PNPM_HOME/bin/node" ]] ||
  [[ "$("$PNPM_HOME/bin/node" --version)" != "v$node_version" ]]; then
  "$PNPM_HOME/bin/pnpm" runtime set node "$node_version" --global
fi

mkdir -p "$HOME/.config/amp"
cat > "$HOME/.config/amp/nopeus-env.bash" <<EOF
export PNPM_HOME="$PNPM_HOME"
case ":\$PATH:" in
  *":\$PNPM_HOME/bin:"*) ;;
  *) export PATH="\$PNPM_HOME/bin:\$PATH" ;;
esac
EOF

marker="# Nopeus orb Node.js and pnpm environment"
touch "$HOME/.bash_profile"
sed -i \
  -e '\|^# Nopeus orb development environment$|d' \
  -e '\|^# Nopeus orb Node.js and pnpm environment$|d' \
  -e '\|^source "\$HOME/.config/amp/nopeus-env.bash"$|d' \
  "$HOME/.bash_profile"
printf '\n%s\n%s\n' \
  "$marker" \
  'source "$HOME/.config/amp/nopeus-env.bash"' \
  >> "$HOME/.bash_profile"

echo "Installing workspace dependencies from the lockfile"
: "${NODE_AUTH_TOKEN:?Configure the Amp NODE_AUTH_TOKEN secret}"
time "$PNPM_HOME/bin/pnpm" install --frozen-lockfile
"$repo_root/.agents/resume"
echo "Orb setup complete in ${SECONDS}s: Node $(node --version), pnpm $(pnpm --version)"
