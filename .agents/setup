#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Match CI without requiring a Nix shell: the flake supplies tools, not extra
# build environment variables. The orb already provides bootstrap Node/npm.
node_version="$(node -p 'require("./package.json").engines.node.replace(/^\^/, "")')"
pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
toolchain="$HOME/.local/share/nopeus-toolchain"

echo "Preparing Node $node_version and pnpm $pnpm_version"
if [[ ! -x "$toolchain/bin/node" || "$("$toolchain/bin/node" --version)" != "v$node_version" ]]; then
  time npm install --global --prefix "$toolchain" --no-audit --no-fund "node@$node_version"
fi
export PATH="$toolchain/bin:$PATH"
if [[ ! -x "$toolchain/bin/pnpm" || "$("$toolchain/bin/pnpm" --version)" != "$pnpm_version" ]]; then
  time npm install --global --prefix "$toolchain" --no-audit --no-fund "pnpm@$pnpm_version"
fi

# Amp and supervised services enter fresh login shells. Scope activation to this
# repository and its packages, and avoid adding the path more than once.
profile_marker="# Nopeus orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
case "\$PWD/" in
  "$repo_root/"*)
    case ":\$PATH:" in
      *":$toolchain/bin:"*) ;;
      *) export PATH="$toolchain/bin:\$PATH" ;;
    esac
    ;;
esac
EOF
fi

echo "Installing workspace dependencies from the lockfile"
time pnpm install --frozen-lockfile
"$repo_root/.agents/resume"
echo "Orb setup complete: Node $(node --version), pnpm $(pnpm --version)"
