{
  "name": "@adamaho/nopeus-oxlint-config",
  "version": "0.1.1",
  "description": "Shared base Oxlint configuration for strict TypeScript codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamaho/nopeus.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf node_modules dist build .turbo coverage",
    "lint": "oxlint --config ./src/base.ts src",
    "prepack": "pnpm build",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@nopeus/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0 <2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
