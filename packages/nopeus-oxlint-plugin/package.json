{
  "name": "@adamaho/nopeus-oxlint-plugin",
  "version": "0.1.2",
  "description": "The canonical strict Oxlint policy for AI-assisted TypeScript codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamaho/nopeus.git",
    "directory": "packages/nopeus-oxlint-plugin"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./effect": {
        "types": "./dist/effect.d.mts",
        "import": "./dist/effect.mjs"
      }
    },
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/effect.ts --dts --format esm --out-dir dist --sourcemap",
    "clean": "rimraf node_modules dist build .turbo coverage tsconfig.tsbuildinfo",
    "lint": "oxlint --config ../nopeus-oxlint-config/src/base.ts src",
    "prepack": "pnpm build",
    "test:unit": "vitest run",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@nopeus/tool-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0 <2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
