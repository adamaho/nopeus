{
  "name": "@adamaho/nopeus-oxlint-plugin",
  "version": "0.7.0",
  "description": "The canonical strict Oxlint policy for AI-assisted TypeScript codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamaho/nopeus.git",
    "directory": "packages/nopeus-oxlint-plugin"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./base": "./src/base.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./effect": {
        "types": "./dist/effect.d.mts",
        "import": "./dist/effect.mjs"
      },
      "./base": {
        "types": "./dist/base.d.mts",
        "import": "./dist/base.mjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf node_modules dist build .turbo coverage tsconfig.tsbuildinfo",
    "lint": "oxlint --config oxlint.config.ts src test",
    "prepack": "pnpm build",
    "test:unit": "vitest run",
    "tsc": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:",
    "oxc-resolver": "catalog:"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "workspace:*",
    "@effect/vitest": "catalog:",
    "@nopeus/tool-tsconfig": "workspace:*",
    "@nopeus/tool-tsdown-config": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0 <2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
