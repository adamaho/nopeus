{
  "name": "@adamaho/nopeus-oxlint-config",
  "version": "0.4.1",
  "description": "Shared base Oxlint configuration for strict TypeScript codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamaho/nopeus.git",
    "directory": "packages/nopeus-oxlint-config"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/base.ts",
    "./base": "./src/base.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/base.d.mts",
        "import": "./dist/base.mjs"
      },
      "./base": {
        "types": "./dist/base.d.mts",
        "import": "./dist/base.mjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf node_modules dist build .turbo coverage",
    "lint": "oxlint --config ./src/base.ts src",
    "prepack": "pnpm build",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@nopeus/tool-tsconfig": "workspace:*",
    "@nopeus/tool-tsdown-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0 <2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
