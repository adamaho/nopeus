{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "tsc": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "^lint"],
      "outputs": []
    },
    "fmt": {
      "outputs": []
    },
    "fmt:check": {
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["transit"]
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:component": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
