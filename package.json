{
  "name": "nopeus",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check": "pnpm fmt:check && turbo run lint test:unit tsc",
    "clean": "turbo run clean && rimraf node_modules",
    "dev": "turbo run dev --ui=tui",
    "lint": "turbo run lint",
    "changeset:publish": "changeset publish",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "tsc": "turbo run tsc",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxfmt-config": "workspace:*",
    "@changesets/cli": "catalog:",
    "oxfmt": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
